---
import type { Portfolio } from '../lib/portfolio';
interface Props { navigation: Portfolio['navigation']; location: string }
const { navigation, location } = Astro.props;
---
<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-mark" href="#top" aria-label="Back to top">
      <img src="/images/brand/mascot-concept-logo.png" alt="" width="1254" height="1254" />
    </a>
    <nav aria-label="Main navigation"><ul>{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
    <span class="header-location mono"><span class="header-location__dot" aria-hidden="true"></span>{location}</span>
  </div>
</header>
