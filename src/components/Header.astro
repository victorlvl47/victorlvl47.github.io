---
import type { Locale, Portfolio } from '../lib/portfolio';
interface Props { navigation: Portfolio['navigation']; locale: Locale; ui: Portfolio['ui'] }
const { navigation, locale, ui } = Astro.props;
const languageLinks = [
  { locale: 'en', label: 'English', href: '/' },
  { locale: 'es', label: 'Español', href: '/es/' }
] as const;
---
<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-mark" href="#top" aria-label={ui.backToTopLabel}>
      <img src="/images/brand/mascot-concept-logo.png" alt="" width="1254" height="1254" />
    </a>
    <nav aria-label={ui.mainNavigationLabel}><ul>{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
    <div class="site-header__meta">
      <details class="language-selector" data-language-selector>
        <summary class="mono" aria-label={ui.languageSelectorLabel}>
          <img class="language-selector__world" src="/images/icons/world-icon.svg" alt="" width="18" height="18" />
          <span>{locale.toUpperCase()}</span>
          <img class="language-selector__triangle" src="/images/icons/triangle-up.svg" alt="" width="12" height="12" />
        </summary>
        <ul aria-label={ui.languageSelectorLabel}>
          {languageLinks.map((language) => <li><a class="mono" href={language.href} lang={language.locale} hreflang={language.locale} aria-current={locale === language.locale ? 'page' : undefined} data-language-link>{language.label}{locale === language.locale && <span class="language-selector__active-icon" aria-hidden="true"></span>}</a></li>)}
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  const selector = document.querySelector<HTMLDetailsElement>('[data-language-selector]');
  const knownHashes = new Set(['#about', '#projects', '#contact']);
  if (selector) {
    selector.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
      link.addEventListener('click', () => {
        if (knownHashes.has(window.location.hash)) link.hash = window.location.hash;
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && selector.open) {
        selector.open = false;
        selector.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (selector.open && event.target instanceof Node && !selector.contains(event.target)) selector.open = false;
    });
  }
</script>
