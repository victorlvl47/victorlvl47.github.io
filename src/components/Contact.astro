---
import type { Portfolio } from '../lib/portfolio';
import { Icon } from 'astro-icon/components';
interface Props { contact: Portfolio['contact']; backgroundImage: Portfolio['hero']['image']; ui: Portfolio['ui'] }
const { contact, backgroundImage, ui } = Astro.props;
const socialIcons: Record<string, string> = {
  facebook: 'simple-icons:facebook',
  email: 'email',
  github: 'simple-icons:github',
  x: 'simple-icons:x',
  youtube: 'simple-icons:youtube',
  linkedin: 'simple-icons:linkedin',
  reddit: 'simple-icons:reddit'
};
---
<section id="contact" class="contact section-rule" aria-labelledby="contact-title" data-parallax-section>
  <div class="contact__background" aria-hidden="true"><picture><source media="(max-width: 700px)" srcset="/images/placeholders/corridor-hero-mobile.png" width="1122" height="1402" /><img data-parallax-artwork src={backgroundImage.url} alt="" width="1920" height="1080" loading="lazy" decoding="async" /></picture></div>
  <div class="shell contact__grid" data-parallax-copy>
    <div class="contact__copy">
      <p class="eyebrow mono">{contact.eyebrow}</p>
      <h2 id="contact-title">{contact.heading}</h2>
      <p class="contact__intro">{contact.intro}</p>
      <a class="button button--primary" href={`mailto:${contact.email}`}>{contact.emailAction} <span aria-hidden="true">↗</span></a>
      <div class="contact__email-row">
        <span class="contact__email mono" data-email-address>{contact.email}</span>
        <button class="contact__copy-button mono" type="button" data-copy-email data-success={ui.emailCopied} data-error={ui.emailCopyError} hidden aria-label={ui.copyEmailLabel}>{ui.copyEmailAction}</button>
        <span class="contact__copy-status mono" role="status" aria-live="polite" data-copy-status></span>
      </div>
      <p class="contact__label mono">{contact.linksLabel}</p>
      <ul class="contact__links">{contact.links.map((link) => <li><a href={link.url} target={link.id === 'email' ? undefined : '_blank'} rel={link.id === 'email' ? undefined : 'noopener noreferrer'} aria-label={link.id === 'email' ? link.label : `${link.label} (${ui.opensInNewTab})`}><span class="contact__link-content">{socialIcons[link.id] && <Icon name={socialIcons[link.id]} class="contact__social-icon" aria-hidden="true" />}<span>{link.label}</span></span><span aria-hidden="true">↗</span></a></li>)}</ul>
    </div>
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const email = document.querySelector<HTMLElement>('[data-email-address]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  if (copyButton && email && status) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      const address = email.textContent?.trim() ?? '';
      if (!address) return;

      try {
        if (navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(address);
            status.textContent = copyButton.dataset.success ?? '';
            return;
          } catch {
            // Clipboard access can be unavailable on a phone using a local HTTP address.
          }
        }

        const field = document.createElement('textarea');
        field.value = address;
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.append(field);
        try {
          field.focus();
          field.select();
          if (!document.execCommand('copy')) throw new Error('Copy failed');
        } finally {
          field.remove();
        }
        status.textContent = copyButton.dataset.success ?? '';
      } catch {
        status.textContent = copyButton.dataset.error ?? '';
      }
    });
  }
</script>
