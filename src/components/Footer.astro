---
import type { Portfolio } from '../lib/portfolio';
interface Props { footer: Portfolio['footer']; name: string }
const { footer, name } = Astro.props;
---
<footer class="site-footer section-rule">
  <div class="shell site-footer__grid">
    <div><a class="site-mark" href="#top" aria-label="Back to top">{footer.mark}</a><p class="mono">{name} © {new Date().getFullYear()}</p></div>
    <div><blockquote>“{footer.quote}” <cite>— {footer.quoteAttribution}</cite></blockquote><p class="mono">{footer.location}</p></div>
    <a class="site-footer__top mono" href="#top">{footer.topAction} ↑</a>
  </div>
</footer>
