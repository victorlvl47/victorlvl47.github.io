---
import type { Portfolio } from '../lib/portfolio';
interface Props { site: Portfolio['site']; hero: Portfolio['hero'] }
const { site, hero } = Astro.props;
---
<section id="about" class="hero section-rule" aria-labelledby="hero-title" data-hero-parallax>
  <div class="room-image hero__image" aria-hidden="true">
    <picture>
      <source media="(max-width: 700px)" srcset="/images/placeholders/corridor-hero-mobile.png" width="1122" height="1402" />
      <img data-hero-parallax-artwork src={hero.image.url} alt={hero.image.alt} width="1920" height="1080" decoding="async" fetchpriority="high" />
    </picture>
  </div>
  <div class="shell hero__inner">
    <div class="hero__copy" data-hero-parallax-copy>
      <p class="eyebrow mono">{hero.eyebrow}</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="hero__role mono">{site.role}</p>
      <p class="hero__tagline">{site.tagline}</p>
      <div class="hero__actions"><a class="button button--primary" href="#projects">{hero.primaryAction} <span aria-hidden="true">→</span></a><a class="button button--ghost" href="#contact">{hero.secondaryAction}</a></div>
      <div class="hero__preview">
        <span class="mono">{hero.previewLabel}</span>
        <p>{hero.previewText}</p>
        <a class="hero__preview-link mono" href={hero.previewLinkUrl} target="_blank" rel="noreferrer" aria-label={`${hero.previewLinkLabel} (opens in a new tab)`}>{hero.previewLinkLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>
