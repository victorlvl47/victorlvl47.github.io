---
import type { Portfolio } from '../lib/portfolio';
interface Props { site: Portfolio['site']; hero: Portfolio['hero']; opensInNewTab: string }
const { site, hero, opensInNewTab } = Astro.props;
---
<section id="about" class="hero section-rule" aria-labelledby="hero-title" data-parallax-section>
  <div class="room-image hero__image" aria-hidden="true">
    <picture>
      <source media="(max-width: 700px)" srcset="/images/placeholders/corridor-hero-mobile.png" width="1122" height="1402" />
      <img data-parallax-artwork src={hero.image.url} alt={hero.image.alt} width="1672" height="941" decoding="async" fetchpriority="high" />
    </picture>
  </div>
  <div class="shell hero__inner">
    <div class="hero__copy" data-parallax-copy>
      <p class="eyebrow mono">{hero.eyebrow}</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="hero__role mono">{site.role}</p>
      <p class="hero__tagline">{site.tagline}</p>
      <div class="hero__actions"><a class="button button--primary" href="#projects">{hero.primaryAction} <span class="hero-action-icon" aria-hidden="true"></span></a><a class="button button--ghost" href="#contact">{hero.secondaryAction}</a></div>
      <div class="hero__preview">
        <span class="mono">{hero.previewLabel}</span>
        <p>{hero.previewText}</p>
        <a class="hero__preview-link mono" href={hero.previewLinkUrl} target="_blank" rel="noreferrer" aria-label={`${hero.previewLinkLabel} (${opensInNewTab})`}>{hero.previewLinkLabel} <span class="external-link-icon" aria-hidden="true"></span></a>
      </div>
    </div>
  </div>
</section>
